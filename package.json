{
  "name": "@kosli/mcp-server",
  "version": "0.5.0",
  "description": "Model Context Protocol server for the Kosli API",
  "type": "module",
  "bin": {
    "kosli-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-catalog": "tsx scripts/generate-catalog.ts",
    "sync-version": "node scripts/sync-version.mjs",
    "version": "npm run sync-version && git add src/version.ts package.json package-lock.json",
    "pack:mcpb": "bash scripts/pack-mcpb.sh",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosli-dev/mcp-server.git"
  },
  "homepage": "https://github.com/kosli-dev/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/kosli-dev/mcp-server/issues"
  },
  "license": "MIT",
  "keywords": [
    "kosli",
    "mcp",
    "model-context-protocol",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
